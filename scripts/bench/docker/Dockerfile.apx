# ── Stage 0: Chef base (maturin + sccache + cargo-chef) ──────────
FROM ghcr.io/pyo3/maturin:v1.8.3 AS chef

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Pin Python 3.11 (manylinux image ships multiple versions; 3.9 is first on PATH)
ENV PATH=/opt/python/cp311-cp311/bin:$PATH

# sccache for cached compilation
RUN curl -sSL https://github.com/mozilla/sccache/releases/download/v0.13.0/sccache-v0.13.0-x86_64-unknown-linux-musl.tar.gz \
    | tar xz -C /usr/local/bin --strip-components=1 sccache-v0.13.0-x86_64-unknown-linux-musl/sccache
ENV RUSTC_WRAPPER=sccache

WORKDIR /build

# Copy rust-toolchain.toml so rustup installs the project toolchain (1.92)
# before compiling cargo-chef (latest cargo-chef requires rustc >= 1.86)
COPY rust-toolchain.toml ./
RUN --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo install cargo-chef --locked

# ── Stage 1: Plan (extract dependency recipe) ────────────────────
# IMPORTANT: Only copy Cargo manifests and lock file — NOT full source.
# This isolates the recipe from source-only changes, so cargo chef cook
# stays cached when only .rs files change.
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/common/Cargo.toml crates/common/Cargo.toml
COPY crates/db/Cargo.toml crates/db/Cargo.toml
COPY crates/databricks_sdk/Cargo.toml crates/databricks_sdk/Cargo.toml
COPY crates/core/Cargo.toml crates/core/Cargo.toml
COPY crates/cli/Cargo.toml crates/cli/Cargo.toml
COPY crates/apx/Cargo.toml crates/apx/Cargo.toml
COPY crates/framework/Cargo.toml crates/framework/Cargo.toml
COPY crates/agent/Cargo.toml crates/agent/Cargo.toml
COPY crates/mcp/Cargo.toml crates/mcp/Cargo.toml
# Exclude studio (tauri) — not needed for server builds
RUN sed -i 's/, "crates\/studio"//' Cargo.toml
# Create stub source files so cargo metadata succeeds
RUN for dir in crates/*/; do \
      mkdir -p "$dir/src"; \
      if [ -f "$dir/Cargo.toml" ]; then \
        grep -q '\[\[bin\]\]' "$dir/Cargo.toml" && touch "$dir/src/main.rs"; \
        touch "$dir/src/lib.rs"; \
      fi; \
    done
RUN cargo chef prepare --recipe-path recipe.json

# ── Stage 2: Build ───────────────────────────────────────────────
FROM chef AS builder

# 1. Cook dependencies (cached until Cargo.toml/Cargo.lock change)
COPY --from=planner /build/recipe.json recipe.json

# Stub files expected by crate build.rs scripts during cook
# Detect arch so the stub filename matches what build.rs expects
RUN mkdir -p .bins/agent skills/apx \
    && ARCH=$(uname -m) && case "$ARCH" in x86_64) AGENT_ARCH=x64;; *) AGENT_ARCH="$ARCH";; esac \
    && touch ".bins/agent/apx-agent-linux-${AGENT_ARCH}" \
    && touch skills/apx/SKILL.md skills/apx/backend-patterns.md skills/apx/frontend-patterns.md

RUN --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    PYO3_PYTHON=/opt/python/cp311-cp311/bin/python3.11 \
    cargo chef cook --release --recipe-path recipe.json

# 2. Copy real source — changes here invalidate only compile steps below.
#    sccache ensures only the changed crates are recompiled (~10-20s).
COPY Cargo.toml Cargo.lock rust-toolchain.toml README.md ./
RUN sed -i 's/, "crates\/studio"//' Cargo.toml
COPY crates/ ./crates/
COPY src/ ./src/
COPY pyproject.toml ./
COPY skills/ ./skills/

# 3. Build apx-agent binary and place where build.rs expects it
RUN --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo build --release -p apx-agent \
    && ARCH=$(uname -m) && case "$ARCH" in x86_64) AGENT_ARCH=x64;; *) AGENT_ARCH="$ARCH";; esac \
    && mkdir -p .bins/agent \
    && cp target/release/apx-agent ".bins/agent/apx-agent-linux-${AGENT_ARCH}"

# ── Build wheel (with sccache + cargo registry cache) ────────────
RUN --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    maturin build --release --out /build/dist/

# ── Stage 3: Runtime ──────────────────────────────────────────────
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY --from=builder /build/dist/apx-*.whl /tmp/
RUN uv pip install --system /tmp/apx-*.whl fastapi uvloop py-spy \
    && rm -f /tmp/apx-*.whl

WORKDIR /app
COPY scripts/bench/app/ ./app/

EXPOSE 8000

# Match tokio thread count to the container CPU limit (--cpus=2) for fair
# comparison with uvicorn's 1-thread-per-worker model. Without this, tokio
# defaults to the host's CPU count, creating unnecessary contention.
ENV TOKIO_WORKER_THREADS=2

CMD ["apx", "serve", "app.main", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
