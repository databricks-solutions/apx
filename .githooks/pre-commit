#!/usr/bin/env bash
set -euo pipefail

# Cargo fmt — must match CI exactly:
#   cargo fmt --all -- --check
echo "Running cargo fmt --all -- --check..."
if ! cargo fmt --all -- --check; then
    echo ""
    echo "Formatting check failed. Run 'cargo fmt --all' to fix."
    exit 1
fi

# Cargo clippy — strict lints for library and binary code
echo "Running cargo clippy (lib + bins)..."
if ! cargo clippy --workspace --exclude apx-studio --lib --bins -- -D warnings; then
    echo ""
    echo "Clippy check failed. Fix the warnings above."
    exit 1
fi

# Cargo clippy — relaxed lints for test code (allow unwrap/expect/panic in tests)
echo "Running cargo clippy (tests)..."
if ! cargo clippy --workspace --exclude apx-studio --tests -- -D warnings \
    -A clippy::unwrap-used -A clippy::expect-used -A clippy::panic; then
    echo ""
    echo "Clippy check failed. Fix the warnings above."
    exit 1
fi
